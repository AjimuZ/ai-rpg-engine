# Default deny: only reviewed engine build inputs may enter the root context.
# Adding a new build input requires updating the real BuildKit regression test.
**
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/.npmrc
!frontend/angular.json
!frontend/tsconfig.json
!frontend/tsconfig.app.json
!frontend/tsconfig.spec.json
!frontend/src/
!frontend/src/**
!frontend/tools/
frontend/tools/**
!frontend/tools/check-localization.mjs
!frontend/tools/check-localization.test.mjs
!frontend/tools/localize-index.mjs
!frontend/public/
!frontend/public/**
!backend/
backend/**
!backend/pom.xml
!backend/mvnw
!backend/mvnw.cmd
!backend/.mvn/
backend/.mvn/**
!backend/.mvn/maven.config
!backend/.mvn/settings.xml
!backend/.mvn/wrapper/
backend/.mvn/wrapper/**
!backend/.mvn/wrapper/maven-wrapper.properties
!backend/src/
!backend/src/**
# The one probe file the backend's drift check compares with its own copy.
!tools/
tools/**
!tools/runtime_probe/
tools/runtime_probe/**
!tools/runtime_probe/fixtures/
tools/runtime_probe/fixtures/**
!tools/runtime_probe/fixtures/0.164.0/
tools/runtime_probe/fixtures/0.164.0/**
!tools/runtime_probe/fixtures/0.164.0/neutral-session.json
!docker/
docker/**
!docker/engine/
docker/engine/**
!docker/engine/Dockerfile

# These exclusions follow all admissions so nested private data cannot re-enter.
**/.git
**/.agents
**/.claude
**/.codex
**/AGENTS.md
**/AGENTS.override.md
**/CLAUDE.md
**/CLAUDE.local.md
**/.mcp.json
**/.env
**/.env.*
**/.local
**/runtime-data
**/backups
**/logs
**/secrets
**/auth.json
**/*.key
**/*.pem
**/*.log
**/__pycache__
**/*.py[cod]
**/node_modules
**/.angular
**/dist
**/target
**/coverage
**/.idea
**/.vscode
**/*.iml
**/.DS_Store
**/Thumbs.db
**/Desktop.ini
**/.ssh
**/.aws
**/.gnupg
**/*.p12
**/*.pfx
