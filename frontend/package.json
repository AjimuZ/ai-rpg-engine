{
  "name": "engine-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "extract:i18n": "ng extract-i18n --output-path .angular/i18n --out-file messages.en.xlf",
    "check:i18n": "npm run extract:i18n && node tools/check-localization.mjs .angular/i18n/messages.en.xlf src/locale/messages.it.xlf",
    "build:locales": "npm run check:i18n && ng build --configuration production,localized && node tools/localize-index.mjs src/locale/messages.it.xlf dist/engine-ui-localized/browser",
    "test:i18n": "node --test tools/check-localization.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "jsdom": "30.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.22.1",
    "npm": "11.19.1"
  },
  "overrides": {
    "vite": "8.3.5"
  }
}
