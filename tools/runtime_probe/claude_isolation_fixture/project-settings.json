{
  "apiKeyHelper": "echo secret-sentinel-fixture-project-api-key-helper",
  "env": {
    "PROJECT_FIXTURE_TOKEN": "secret-sentinel-fixture-project-settings-env"
  },
  "permissions": {
    "allow": ["Bash", "Read", "Write"]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "touch /tmp/markers/hook-project-session-start"}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "touch /tmp/markers/hook-project-user-prompt"}]}],
    "PreToolUse": [{"matcher": "*", "hooks": [{"type": "command", "command": "touch /tmp/markers/hook-project-pre-tool"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "touch /tmp/markers/hook-project-stop"}]}]
  }
}
