<?xml version="1.0" encoding="UTF-8"?>
<!-- Neutral modular application. Spring Boot owns library and plugin versions. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>
  <groupId>org.rpgengine</groupId>
  <artifactId>engine</artifactId>
  <version>0.1.0</version>
  <name>Adventure engine</name>
  <description>Neutral application shell for the modular adventure engine</description>
  <properties>
    <java.version>21</java.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-reviewed-toolchain</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.10.0,3.11)</version></requireMavenVersion>
                <requireReleaseDeps/>
                <banDynamicVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>packaged-ui</id>
      <properties>
        <!-- Consume production output only; never expose frontend source as resources. -->
        <ui.dist.directory>${project.basedir}/../frontend/dist/engine-ui/browser</ui.dist.directory>
      </properties>
      <build>
        <resources>
          <resource>
            <directory>src/main/resources</directory>
            <filtering>false</filtering>
          </resource>
          <resource>
            <directory>${ui.dist.directory}</directory>
            <targetPath>static</targetPath>
            <!-- Filtering would corrupt bundles and content-hashed filenames. -->
            <filtering>false</filtering>
          </resource>
          <resource>
            <!-- Angular emits extracted dependency licenses next to browser/. -->
            <directory>${ui.dist.directory}/..</directory>
            <includes><include>3rdpartylicenses.txt</include></includes>
            <targetPath>static</targetPath>
            <filtering>false</filtering>
          </resource>
        </resources>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>require-compiled-interface</id>
                <phase>process-classes</phase>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <!-- Check the copied resource before tests/package. Enforcer requires a
                         canonical path; the sibling frontend path contains a parent segment. -->
                    <requireFilesExist>
                      <files>
                        <file>${project.build.outputDirectory}/static/index.html</file>
                        <file>${project.build.outputDirectory}/static/3rdpartylicenses.txt</file>
                      </files>
                      <message>Build the production interface with npm ci and npm run build in frontend/ first.</message>
                    </requireFilesExist>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <!-- Ordinary backend tests remain independent of the frontend build. -->
                <engine.packaged-ui>true</engine.packaged-ui>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
