{
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "taskId", "taskKind", "baseRevision", "contextDigest", "outputLocale", "status", "body"],
  "properties": {
    "contractVersion": {"type": "integer", "enum": [1]},
    "taskId": {"type": "string", "maxLength": 36},
    "taskKind": {"type": "string", "enum": ["narration"]},
    "baseRevision": {"type": "integer"},
    "contextDigest": {"type": "string", "maxLength": 64},
    "outputLocale": {"type": "string", "enum": ["en", "it"]},
    "status": {"type": "string", "enum": ["proposed", "cannot-complete"]},
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pendingDecisionId", "passages", "suggestions", "reasonCode"],
      "properties": {
        "pendingDecisionId": {"type": ["string", "null"], "maxLength": 128},
        "passages": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["passageId", "kind", "speakerId", "text", "references", "quoteIds"],
            "properties": {
              "passageId": {"type": "string", "maxLength": 32},
              "kind": {"type": "string", "enum": ["narration", "characterSpeech"]},
              "speakerId": {"type": ["string", "null"], "maxLength": 36},
              "text": {"type": "string", "maxLength": 1200},
              "references": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "maxLength": 128}},
              "quoteIds": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 128}}
            }
          }
        },
        "suggestions": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["suggestionId", "kind", "label", "draftText", "actionId"],
            "properties": {
              "suggestionId": {"type": "string", "maxLength": 32},
              "kind": {"type": "string", "enum": ["reply", "question", "action"]},
              "label": {"type": "string", "maxLength": 80},
              "draftText": {"type": "string", "maxLength": 500},
              "actionId": {"type": ["string", "null"], "maxLength": 128}
            }
          }
        },
        "reasonCode": {"type": ["string", "null"], "enum": ["missing-information", "out-of-scope", null]}
      }
    }
  }
}
