{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rpgengine:pack:1:localization",
  "title": "Contract 1 text-only overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "field",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "field": {
            "$ref": "#/$defs/text"
          },
          "text": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    }
  }
}
