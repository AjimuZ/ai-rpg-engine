# Shared editor defaults; Git's .gitattributes controls checkout normalization.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.{java,py}]
indent_size = 4

# Preserve intentional Markdown hard line breaks.
[*.md]
trim_trailing_whitespace = false
