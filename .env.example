# Sanitized settings for the account-free application shell Compose file.
# The launcher and account/gameplay readiness remain later development tasks.
# Compose reads an ignored local .env by default; no credentials belong in it.
# Never put passwords, tokens, account state, or personal paths in this example.

# Published engine HTTP port; Compose always binds it to 127.0.0.1.
APP_PORT=8080

# Database initialization labels; changing them does not migrate an existing cluster.
# Put the password in .local/secrets/postgres-password, never in this example.
# POSTGRES_PASSWORD_FILE may override that private host file's path, not its value.
POSTGRES_DB=engine
POSTGRES_USER=engine
