# Sanitized placeholders for future local container configuration.
# No current service consumes these settings; this file does not start the engine.
# Copy to an ignored local .env only when implementation documents its use.
# Never put passwords, tokens, account state, or personal paths in this example.

# Proposed local application port; the packaged interface must bind to loopback.
APP_PORT=8080

# Neutral database labels only; these do not configure database authentication.
# Future tooling must obtain passwords from private secret files, not this example.
POSTGRES_DB=engine
POSTGRES_USER=engine
